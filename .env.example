# ============================================================
# OpenMind LLM — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Model ────────────────────────────────────────────────────
# Path to the model weights directory (used by the server)
MODEL_PATH=./weights/model.pt

# Hugging Face Model Hub repo to download weights from
# Format: "username/repo-name"
HF_MODEL_REPO=Rachit17-12/openmind-125m

# ── Server ───────────────────────────────────────────────────
# Host and port for the inference server
# (HF Spaces requires port 7860)
SERVER_HOST=0.0.0.0
SERVER_PORT=7860

# ── Hugging Face Hub ─────────────────────────────────────────
# Optional: HF token for downloading private models/repos
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Experiment Tracking (optional) ──────────────────────────
# Weights & Biases API key for training runs
WANDB_API_KEY=
